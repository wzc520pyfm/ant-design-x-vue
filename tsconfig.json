{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "moduleResolution": "node",
    "strictNullChecks": false,
    "baseUrl": "./",
    "types": ["unplugin-vue-macros/macros-global", "node"],
    "paths": {
      "ant-design-x-vue": ["packages/components"],
      "ant-design-x-vue/*": ["packages/components/*"],
      "@ant-design-x-vue/components": ["packages/components"],
      "@ant-design-x-vue/components/*": ["packages/components/*"],
      "@ant-design-x-vue/x-sdk": ["packages/x-sdk/src/index.ts"],
      "@ant-design-x-vue/x-markdown": ["packages/x-markdown/src/index.ts"],
      "@ant-design-x-vue/*": ["packages/*"]
    }
  },
  "vueCompilerOptions": {
    "plugins": ["unplugin-vue-macros/volar"]
  },
  "include": ["packages/components/**/*", "docs/**/*", "internal/**/*"]
}
